    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-WebApp-5505b25e-67f5-473b-aac1-a3f3a228073b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="WebApp.Tests/**" />
