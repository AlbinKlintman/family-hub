@page "{id:int}"
@model WebApp.Pages.Training.WorkoutModel
@using WebApp.Models
@{
    ViewData["Title"] = "Workout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">
        <span class="badge note-badge session-badge-@Model.WorkoutEntity.SessionType.ToString().ToLowerInvariant()">@Model.WorkoutEntity.SessionType.ToDisplayName()</span>
        @Model.WorkoutEntity.Date.ToString("ddd, MMM d")
        @if (Model.WorkoutEntity.Time is not null)
        {
            @(" at " + Model.WorkoutEntity.Time.Value.ToString("HH:mm"))
        }
    </h1>
    <a asp-page="/Training/Index" class="btn btn-outline-secondary btn-sm">Back to Training</a>
</div>

<form method="post" asp-page-handler="AddExercise" class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label asp-for="AddExerciseInput.ExerciseId" class="form-label text-secondary small"></label>
                <select asp-for="AddExerciseInput.ExerciseId" asp-items="Model.ExerciseOptions" class="form-select">
                    <option value="">&mdash; Select an exercise &mdash;</option>
                </select>
                <div class="form-text">
                    Don't see it? <a asp-page="/Exercises/Create">Add a @Model.WorkoutEntity.SessionType.ToDisplayName() exercise</a> first.
                </div>
            </div>
            <div class="col-6 col-md-3">
                <label asp-for="AddExerciseInput.SetCount" class="form-label text-secondary small"></label>
                <input asp-for="AddExerciseInput.SetCount" type="number" class="form-control" />
            </div>
            <div class="col-6 col-md-3">
                <button type="submit" class="btn btn-primary w-100">+ Add</button>
            </div>
        </div>
    </div>
</form>

@if (!Model.WorkoutEntity.Exercises.Any())
{
    <p class="text-secondary">No exercises added yet.</p>
}
else
{
    @foreach (var workoutExercise in Model.WorkoutEntity.Exercises)
    {
        var exercise = workoutExercise.Exercise!;
        var sets = workoutExercise.Sets.ToList();
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 mb-0">@exercise.Name</h2>
                    <form method="post" asp-page-handler="RemoveExercise" asp-route-workoutExerciseId="@workoutExercise.Id" onsubmit="return confirm('Remove this exercise from the workout?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                    </form>
                </div>

                <form method="post" asp-page-handler="UpdateSets">
                    <input type="hidden" name="UpdateSetsInput.WorkoutExerciseId" value="@workoutExercise.Id" />
                    @for (var i = 0; i < sets.Count; i++)
                    {
                        var set = sets[i];
                        <div class="row g-2 align-items-center mb-2">
                            <div class="col-auto">
                                <span class="badge bg-secondary">Set @set.SetNumber</span>
                            </div>
                            <input type="hidden" name="UpdateSetsInput.Sets[@i].SetId" value="@set.Id" />

                            @if (exercise.WeightType == ExerciseWeightType.Machine)
                            {
                                <div class="col">
                                    <select name="UpdateSetsInput.Sets[@i].BaseWeightKg" class="form-select form-select-sm">
                                        <option value="">&mdash; Weight &mdash;</option>
                                        @foreach (var w in exercise.MachineWeights.OrderBy(w => w.WeightKg))
                                        {
                                            <option value="@w.WeightKg" selected="@(set.BaseWeightKg == w.WeightKg)">@w.WeightKg.ToString("0.#") kg</option>
                                        }
                                    </select>
                                </div>
                                <div class="col">
                                    <select name="UpdateSetsInput.Sets[@i].AddOnKg" class="form-select form-select-sm">
                                        <option value="">No add-on</option>
                                        @foreach (var a in exercise.MachineAddOns.OrderBy(a => a.AddOnKg))
                                        {
                                            <option value="@a.AddOnKg" selected="@(set.AddOnKg == a.AddOnKg)">+@a.AddOnKg.ToString("0.#") kg</option>
                                        }
                                    </select>
                                </div>
                            }
                            else
                            {
                                <div class="col">
                                    <input type="number" step="0.5" name="UpdateSetsInput.Sets[@i].WeightKg" class="form-control form-control-sm"
                                           value="@set.WeightKg" placeholder="@(exercise.WeightType == ExerciseWeightType.Bodyweight ? "Extra kg (optional)" : "Weight (kg)")" />
                                </div>
                            }

                            <div class="col">
                                <input type="number" name="UpdateSetsInput.Sets[@i].Reps" class="form-control form-control-sm" value="@set.Reps" placeholder="Reps" />
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-2">
                        <button type="submit" class="btn btn-primary btn-sm">Save sets</button>
                        <button type="submit" formaction="?handler=AddSet&workoutExerciseId=@workoutExercise.Id" class="btn btn-outline-secondary btn-sm">+ Add set</button>
                        @if (sets.Count > 1)
                        {
                            <button type="submit" formaction="?handler=RemoveLastSet&workoutExerciseId=@workoutExercise.Id" class="btn btn-outline-secondary btn-sm">&minus; Remove last set</button>
                        }
                    </div>
                </form>
            </div>
        </div>
    }
}

<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this whole workout? This cannot be undone.');">
    <button type="submit" class="btn btn-outline-danger">Delete Workout</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
