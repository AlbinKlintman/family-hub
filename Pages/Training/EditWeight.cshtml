@page "{id:int}"
@model WebApp.Pages.Training.EditWeightModel
@{
    ViewData["Title"] = "Edit Weight Entry";
}

<h1>Edit Weight Entry</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Date" class="form-label"></label>
                <input asp-for="Input.Date" type="date" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.Time" class="form-label"></label>
                <input asp-for="Input.Time" type="time" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Input.WeightKg" class="form-label"></label>
                <input asp-for="Input.WeightKg" type="number" step="0.1" class="form-control" />
                <span asp-validation-for="Input.WeightKg" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Training/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>

        <form method="post" asp-page-handler="Delete" class="mt-3" onsubmit="return confirm('Delete this weight entry?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">Delete Entry</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
