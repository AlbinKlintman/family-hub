@page "{id:int}"
@model WebApp.Pages.Applications.EditModel
@{
    ViewData["Title"] = "Edit Application";
}

<h1>Edit Application</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.RoleName" class="form-label"></label>
                <input asp-for="Input.RoleName" class="form-control" />
                <span asp-validation-for="Input.RoleName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.CompanyId" class="form-label"></label>
                <select asp-for="Input.CompanyId" asp-items="Model.CompanyOptions" class="form-select">
                    <option value="">&mdash; None &mdash;</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Status" class="form-label"></label>
                <select asp-for="Input.Status" asp-items="Model.StatusOptions" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Input.InterviewDate" class="form-label"></label>
                <input asp-for="Input.InterviewDate" type="date" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Link" class="form-label"></label>
                <input asp-for="Input.Link" class="form-control" placeholder="https://..." />
                <span asp-validation-for="Input.Link" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Chance" class="form-label"></label>
                <select asp-for="Input.Chance" class="form-select">
                    <option value="">&mdash; Not set &mdash;</option>
                    <option value="High">High chance</option>
                    <option value="Medium">Medium chance</option>
                    <option value="Low">Low chance</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Board/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>

        <form method="post" asp-page-handler="Delete" class="mt-3" onsubmit="return confirm('Delete this application? This cannot be undone.');">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-outline-danger">Delete Application</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
