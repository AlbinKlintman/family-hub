@page "{id:int}"
@model WebApp.Pages.Folders.EditModel
@{
    ViewData["Title"] = "Edit Folder";
}

<h1>Edit Folder</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Color" class="form-label"></label>
                <select asp-for="Input.Color" class="form-select">
                    @foreach (var color in Enum.GetValues<WebApp.Models.FolderColor>())
                    {
                        <option value="@color">@color.ToDisplayName()</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ParentFolderId" class="form-label"></label>
                <select asp-for="Input.ParentFolderId" asp-items="Model.ParentOptions" class="form-select">
                    <option value="">&mdash; Top level &mdash;</option>
                </select>
                <span asp-validation-for="Input.ParentFolderId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Folders/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>

        <form method="post" asp-page-handler="Delete" class="mt-3" onsubmit="return confirm('Delete this folder? Subfolders are deleted too; notes inside are kept but unfiled.');">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-outline-danger">Delete Folder</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
