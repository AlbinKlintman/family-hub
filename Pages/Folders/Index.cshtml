@page
@model WebApp.Pages.Folders.IndexModel
@{
    ViewData["Title"] = "Folders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Folders</h1>
    <a asp-page="/Notes/Index" class="btn btn-outline-secondary">All Notes</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        @if (Model.RootFolders.Count == 0)
        {
            <p class="text-secondary mb-0">No folders yet.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0 folder-tree">
                @foreach (var folder in Model.RootFolders)
                {
                    <partial name="_FolderNode" model="(folder, Model.ByParent, Model.NoteCounts)" />
                }
            </ul>
        }
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h6">New folder</h2>
        <form method="post" asp-page-handler="Create" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small text-secondary" asp-for="NewFolderName"></label>
                <input asp-for="NewFolderName" class="form-control" placeholder="Folder name" />
                <span asp-validation-for="NewFolderName" class="text-danger small"></span>
            </div>
            <div class="col-auto">
                <label class="form-label small text-secondary" asp-for="NewFolderColor"></label>
                <select asp-for="NewFolderColor" class="form-select">
                    @foreach (var color in Enum.GetValues<WebApp.Models.FolderColor>())
                    {
                        <option value="@color">@color.ToDisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small text-secondary" asp-for="NewFolderParentId">Parent</label>
                <select asp-for="NewFolderParentId" asp-items="Model.ParentOptions" class="form-select">
                    <option value="">&mdash; Top level &mdash;</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Add Folder</button>
            </div>
        </form>
    </div>
</div>

<style>
    .folder-children {
        margin-left: 1.4rem;
        border-left: 1px solid var(--ios-separator, #38383a);
        padding-left: 0.75rem;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
