@page
@model WebApp.Pages.Media.IndexModel
@using WebApp.Models
@{
    ViewData["Title"] = "Media";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Media</h1>
    <a asp-page="/Media/Create" class="btn btn-primary">+ Add</a>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="Search">Search</label>
        <input asp-for="Search" class="form-control" placeholder="Search by title..." />
    </div>
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="Type">Type</label>
        <select asp-for="Type" class="form-select" onchange="this.form.submit()">
            <option value="">All types</option>
            @foreach (var type in Enum.GetValues<MediaType>())
            {
                <option value="@type">@type.ToDisplayName()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="Status">Status</label>
        <select asp-for="Status" class="form-select" onchange="this.form.submit()">
            <option value="">All statuses</option>
            @foreach (var status in Enum.GetValues<MediaStatus>())
            {
                <option value="@status">@status.ToDisplayName()</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

<p class="small text-secondary mb-2">@Model.SummaryText</p>

@if (!Model.Entries.Any())
{
    <p class="text-muted">No entries here.</p>
}

@{
    ViewData["ReturnUrl"] = Model.HttpContext.Request.Path + Model.HttpContext.Request.QueryString;
}
<div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
    @foreach (var entry in Model.Entries)
    {
        var progress = WebApp.Pages.Media.IndexModel.ProgressText(entry);
        var incrementLabel = WebApp.Pages.Media.IndexModel.IncrementProgressLabel(entry.Type);
        var placeholderIcon = WebApp.Pages.Media.IndexModel.PlaceholderIcon(entry.Type);
        var editUrl = Url.Page("/Media/Edit", new { id = entry.Id });
        <div class="col">
            <div id="media-@entry.Id" class="card h-100 media-tile card-clickable" data-href="@editUrl" role="link" tabindex="0" aria-label="Edit media entry">
                <div class="media-tile-cover">
                    @if (!string.IsNullOrEmpty(entry.CoverImageUrl))
                    {
                        <img src="@entry.CoverImageUrl" alt="" loading="lazy"
                             onerror="this.style.display='none'; this.nextElementSibling.hidden=false;" />
                        <div class="media-tile-placeholder" hidden>@placeholderIcon</div>
                    }
                    else
                    {
                        <div class="media-tile-placeholder">@placeholderIcon</div>
                    }
                    <span class="badge bg-secondary media-tile-type-badge">@entry.Type.ToDisplayName()</span>
                    @if (entry.Rating is not null)
                    {
                        <span class="media-tile-rating">&#9733; @entry.Rating</span>
                    }
                </div>
                <div class="card-body media-tile-body">
                    <div class="media-tile-title">@entry.Title</div>
                    <div class="small mb-1">
                        <span class="badge @entry.Status.ToBadgeCssClass()">@entry.Status.ToDisplayName(entry.Type)</span>
                        @if (progress is not null)
                        {
                            <span class="text-secondary ms-1">@progress</span>
                        }
                    </div>
                    @if (entry.UserId != Model.HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)
                    {
                        <div class="small text-secondary mb-1">Shared by @Model.UsernamesById.GetValueOrDefault(entry.UserId, "someone")</div>
                    }
                    @if (entry.Links.Any())
                    {
                        <div class="media-tile-links">
                            @foreach (var link in entry.Links)
                            {
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="small d-block">Watch/read &#8599;</a>
                            }
                        </div>
                    }
                    @if (incrementLabel is not null)
                    {
                        <form method="post" asp-page-handler="IncrementProgress" asp-route-id="@entry.Id" class="mt-2">
                            <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                            <button type="submit" class="btn btn-outline-success btn-sm w-100 card-action-btn">@incrementLabel</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/card-click.js" asp-append-version="true"></script>
}
