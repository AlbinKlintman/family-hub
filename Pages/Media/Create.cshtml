@page
@model WebApp.Pages.Media.CreateModel
@using WebApp.Models
@{
    ViewData["Title"] = "Add Media";
}

<h1>Add Media</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Type" class="form-label"></label>
                <select asp-for="Input.Type" class="form-select" data-fields-toggle="media-fields">
                    @foreach (var type in Enum.GetValues<MediaType>())
                    {
                        <option value="@type">@type.ToDisplayName()</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Status" class="form-label"></label>
                <select asp-for="Input.Status" class="form-select">
                    @foreach (var status in Enum.GetValues<MediaStatus>())
                    {
                        <option value="@status">@status.ToDisplayName()</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Rating" class="form-label"></label>
                <select asp-for="Input.Rating" class="form-select">
                    <option value="">Select</option>
                    @for (var r = 10; r >= 1; r--)
                    {
                        <option value="@r">@r - @(((int?)r).ToRatingLabel())</option>
                    }
                </select>
                <span asp-validation-for="Input.Rating" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.CoverImageUrl" class="form-label"></label>
                <input asp-for="Input.CoverImageUrl" type="url" class="form-control" placeholder="https://..." />
                <span asp-validation-for="Input.CoverImageUrl" class="text-danger"></span>
            </div>

            <div class="mb-3 d-flex gap-2 media-fields" data-types="Anime,Series">
                <div class="flex-fill">
                    <label asp-for="Input.Season" class="form-label"></label>
                    <input asp-for="Input.Season" type="number" min="0" class="form-control" />
                </div>
                <div class="flex-fill">
                    <label asp-for="Input.Episode" class="form-label"></label>
                    <input asp-for="Input.Episode" type="number" min="0" class="form-control" />
                </div>
            </div>

            <div class="mb-3 d-flex gap-2">
                <div class="flex-fill media-fields" data-types="Manga,Book">
                    <label asp-for="Input.Chapter" class="form-label"></label>
                    <input asp-for="Input.Chapter" type="number" min="0" class="form-control" />
                </div>
                <div class="flex-fill media-fields" data-types="Manga">
                    <label asp-for="Input.Volume" class="form-label"></label>
                    <input asp-for="Input.Volume" type="number" min="0" class="form-control" />
                </div>
                <div class="flex-fill media-fields" data-types="Book">
                    <label asp-for="Input.Page" class="form-label"></label>
                    <input asp-for="Input.Page" type="number" min="0" class="form-control" />
                </div>
            </div>

            <div class="mb-3 form-check media-fields" data-types="Movie">
                <input asp-for="Input.Watched" type="checkbox" class="form-check-input" />
                <label asp-for="Input.Watched" class="form-check-label"></label>
            </div>

            <partial name="_LinkRepeater" model="Model.Input.Links" />

            <button type="submit" class="btn btn-primary">Add Media</button>
            <a asp-page="/Media/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/list-repeater.js" asp-append-version="true"></script>
    <script src="~/js/media-lists.js" asp-append-version="true"></script>
    <script src="~/js/fields-toggle.js" asp-append-version="true"></script>
}
