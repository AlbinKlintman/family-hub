@page
@model WebApp.Pages.Settings.IndexModel
@using WebApp.Models
@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

<div class="row">
    <div class="col-md-6">
        <div class="d-flex align-items-center gap-3 mb-4">
            <partial name="_Avatar" model="new WebApp.Pages.Shared.AvatarInfo(Model.Input.Username, Model.Input.AvatarUrl, Model.Input.AccentColor)" />
            <div class="fw-semibold">@Model.Input.Username</div>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Username" class="form-label"></label>
                <input asp-for="Input.Username" class="form-control" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.AvatarUrl" class="form-label"></label>
                <input asp-for="Input.AvatarUrl" type="url" class="form-control" placeholder="https://..." />
                <span asp-validation-for="Input.AvatarUrl" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.AccentColor" class="form-label"></label>
                <select asp-for="Input.AccentColor" class="form-select">
                    @foreach (var color in Enum.GetValues<FolderColor>())
                    {
                        <option value="@color">@color.ToDisplayName()</option>
                    }
                </select>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="Input.ShowTodaysFastCard" type="checkbox" class="form-check-input" />
                <label asp-for="Input.ShowTodaysFastCard" class="form-check-label"></label>
            </div>

            <hr class="my-4" />

            <h6>Reminders</h6>
            <p class="small text-secondary">
                Reminders about your own notes and interviews are sent here instead of a single shared channel.
            </p>

            <div class="mb-3">
                <label asp-for="Input.DiscordWebhookUrl" class="form-label"></label>
                <input asp-for="Input.DiscordWebhookUrl" type="url" class="form-control" placeholder="https://discord.com/api/webhooks/..." />
                <span asp-validation-for="Input.DiscordWebhookUrl" class="text-danger"></span>
                <div class="form-text">Leave blank if you don't want Discord reminders.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.TelegramChatId" class="form-label"></label>
                <input asp-for="Input.TelegramChatId" class="form-control" placeholder="e.g. 123456789" />
                <span asp-validation-for="Input.TelegramChatId" class="text-danger"></span>
                <div class="form-text">
                    Message <strong>@@family_hub_notify_bot</strong> on Telegram to find your chat ID, then enter it here.
                    Leave blank if you don't want Telegram reminders.
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>

        <hr class="my-4" />

        <p class="text-secondary small">
            Need to change your password or email?
            <a asp-area="Identity" asp-page="/Account/Manage/Index">Manage your account</a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
