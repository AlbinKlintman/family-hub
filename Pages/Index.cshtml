@page
@model IndexModel
@inject Microsoft.AspNetCore.Identity.SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
@{
    ViewData["Title"] = "Home";
}

@if (!SignInManager.IsSignedIn(User))
{
    <div class="hero text-center">
        <h1 class="hero-title">Family Hub</h1>
        <p class="hero-subtitle">
            A private space for your notes, calendar, job search, and training —
            everything kept just between you and your family.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap hero-actions">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-4">Log In</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary btn-lg px-4">Create Account</a>
        </div>

        <div class="row row-cols-2 row-cols-md-4 g-3 hero-features">
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">📅</div>
                        <div class="small fw-semibold mt-2">Calendar</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">📝</div>
                        <div class="small fw-semibold mt-2">Notes</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">💼</div>
                        <div class="small fw-semibold mt-2">Job Applications</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">🏋️</div>
                        <div class="small fw-semibold mt-2">Training</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .hero {
            padding: 4rem 0 3rem;
        }

        .hero-title {
            font-size: 3rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.75rem;
        }

        .hero-subtitle {
            color: var(--ios-label-secondary);
            font-size: 1.15rem;
            max-width: 34rem;
            margin: 0 auto 2rem;
        }

        .hero-actions {
            margin-bottom: 3.5rem;
        }

        .hero-features {
            max-width: 40rem;
            margin: 0 auto;
        }

        .hero-feature-icon {
            font-size: 1.75rem;
        }
    </style>
}
else
{
    <div class="row row-cols-3 row-cols-md-5 g-3 app-icon-grid">
        <div class="col">
            <a asp-page="/Calendar/Index" class="app-icon-tile">
                <div class="app-icon-emoji">📅</div>
                <div class="app-icon-label">Calendar</div>
            </a>
        </div>
        <div class="col">
            <a asp-page="/Notes/Index" class="app-icon-tile">
                <div class="app-icon-emoji">📝</div>
                <div class="app-icon-label">Notes</div>
            </a>
        </div>
        <div class="col">
            <a asp-page="/Board/Index" class="app-icon-tile">
                <div class="app-icon-emoji">💼</div>
                <div class="app-icon-label">Job Applications</div>
            </a>
        </div>
        <div class="col">
            <a asp-page="/Training/Index" class="app-icon-tile">
                <div class="app-icon-emoji">🏋️</div>
                <div class="app-icon-label">Training</div>
            </a>
        </div>
        <div class="col">
            <a asp-page="/Statistics/Index" class="app-icon-tile">
                <div class="app-icon-emoji">📊</div>
                <div class="app-icon-label">Statistics</div>
            </a>
        </div>
    </div>

    <style>
        .app-icon-tile {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            aspect-ratio: 1 / 1;
            background-color: var(--ios-elevated);
            border-radius: 22%;
            text-decoration: none;
            color: var(--ios-label);
            padding: 0.5rem;
            transition: background-color 0.15s ease;
        }

        .app-icon-tile:hover,
        .app-icon-tile:active {
            background-color: var(--ios-elevated-2);
            color: var(--ios-label);
        }

        .app-icon-emoji {
            font-size: 2.5rem;
            line-height: 1;
            margin-bottom: 0.5rem;
        }

        .app-icon-label {
            font-size: 0.8rem;
            font-weight: 600;
            text-align: center;
        }
    </style>
}
