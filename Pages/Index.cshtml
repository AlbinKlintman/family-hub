@page
@model IndexModel
@inject Microsoft.AspNetCore.Identity.SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
@{
    ViewData["Title"] = "Home";
}

@if (!SignInManager.IsSignedIn(User))
{
    <div class="hero text-center">
        <h1 class="hero-title">Family Hub</h1>
        <p class="hero-subtitle">
            A private space for your notes, calendar, job search, and training —
            everything kept just between you and your family.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap hero-actions">
            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary btn-lg px-4">Log In</a>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary btn-lg px-4">Create Account</a>
        </div>

        <div class="row row-cols-2 row-cols-md-4 g-3 hero-features">
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">📅</div>
                        <div class="small fw-semibold mt-2">Calendar</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">📝</div>
                        <div class="small fw-semibold mt-2">Notes</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">💼</div>
                        <div class="small fw-semibold mt-2">Job Applications</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body text-center py-4">
                        <div class="hero-feature-icon">🏋️</div>
                        <div class="small fw-semibold mt-2">Training</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        .hero {
            padding: 4rem 0 3rem;
        }

        .hero-title {
            font-size: 3rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 0.75rem;
        }

        .hero-subtitle {
            color: var(--ios-label-secondary);
            font-size: 1.15rem;
            max-width: 34rem;
            margin: 0 auto 2rem;
        }

        .hero-actions {
            margin-bottom: 3.5rem;
        }

        .hero-features {
            max-width: 40rem;
            margin: 0 auto;
        }

        .hero-feature-icon {
            font-size: 1.75rem;
        }
    </style>
}
else
{
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var monthLabel = new DateOnly(Model.DisplayYear, Model.DisplayMonth, 1).ToString("MMMM yyyy");

    <a asp-page="/Calendar/Index" class="text-decoration-none text-body">
        <div class="card mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-semibold">@monthLabel</span>
                    <span class="text-muted small">View calendar &rsaquo;</span>
                </div>
                <div class="mini-calendar">
                    <div class="mini-calendar-row mini-calendar-header">
                        <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
                    </div>
                    @foreach (var week in Model.Weeks)
                    {
                        <div class="mini-calendar-row">
                            @foreach (var day in week)
                            {
                                var hasEvents = day is not null && Model.EventsByDate.ContainsKey(day.Value);
                                <span class="mini-calendar-day @(day == today ? "mini-calendar-today" : "") @(hasEvents ? "mini-calendar-has-events" : "")">
                                    @(day?.Day.ToString() ?? "")
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </a>

    <div class="row row-cols-2 row-cols-md-3 g-3">
        <div class="col">
            <a asp-page="/Notes/Create" class="btn btn-primary w-100 h-100 py-3">+ New Note</a>
        </div>
        <div class="col">
            <a asp-page="/Applications/Create" class="btn btn-primary w-100 h-100 py-3">+ New Application</a>
        </div>
        <div class="col">
            <a asp-page="/Calendar/Index" class="btn btn-outline-secondary w-100 h-100 py-3">Calendar</a>
        </div>
        <div class="col">
            <a asp-page="/Notes/Index" class="btn btn-outline-secondary w-100 h-100 py-3">Notes</a>
        </div>
        <div class="col">
            <a asp-page="/Board/Index" class="btn btn-outline-secondary w-100 h-100 py-3">Job Applications</a>
        </div>
        <div class="col">
            <a asp-page="/Companies/Index" class="btn btn-outline-secondary w-100 h-100 py-3">Companies</a>
        </div>
        <div class="col">
            <a asp-page="/Training/Index" class="btn btn-outline-secondary w-100 h-100 py-3">Training</a>
        </div>
        <div class="col">
            <a asp-page="/Statistics/Index" class="btn btn-outline-secondary w-100 h-100 py-3">Statistics</a>
        </div>
    </div>

    <style>
        .mini-calendar-row {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            text-align: center;
        }

        .mini-calendar-header {
            font-size: 0.7rem;
            color: var(--ios-label-secondary);
            margin-bottom: 0.25rem;
        }

        .mini-calendar-day {
            display: flex;
            align-items: center;
            justify-content: center;
            justify-self: center;
            width: 1.8em;
            height: 1.8em;
            font-size: 0.8rem;
            border-radius: 50%;
            position: relative;
        }

        .mini-calendar-today {
            background-color: var(--ios-blue);
            color: #fff;
        }

        .mini-calendar-has-events:not(.mini-calendar-today)::after {
            content: "";
            display: block;
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background-color: var(--ios-blue);
            margin: 0 auto;
        }
    </style>
}
