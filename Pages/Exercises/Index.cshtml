@page
@model WebApp.Pages.Exercises.IndexModel
@{
    ViewData["Title"] = "Exercises";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Exercises</h1>
    <div>
        <a asp-page="/Training/Index" class="btn btn-outline-secondary">Back to Training</a>
        <a asp-page="/Exercises/Create" class="btn btn-primary">+ Add Exercise</a>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Session</th>
            <th>Weight type</th>
            <th>Logged</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var exercise in Model.Exercises)
        {
            <tr>
                <td>@exercise.Name</td>
                <td><span class="badge note-badge session-badge-@exercise.SessionType.ToString().ToLowerInvariant()">@exercise.SessionType.ToDisplayName()</span></td>
                <td>@exercise.WeightType.ToDisplayName()</td>
                <td>@exercise.LogCount</td>
                <td><a asp-page="/Exercises/Edit" asp-route-id="@exercise.Id">Edit</a></td>
            </tr>
        }
        @if (!Model.Exercises.Any())
        {
            <tr>
                <td colspan="5" class="text-secondary">No exercises yet.</td>
            </tr>
        }
    </tbody>
</table>
