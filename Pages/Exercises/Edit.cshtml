@page "{id:int}"
@model WebApp.Pages.Exercises.EditModel
@{
    ViewData["Title"] = "Edit Exercise";
}

<h1>Edit Exercise</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Exercises/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>

        <form method="post" asp-page-handler="Delete" class="mt-3" onsubmit="return confirm('Delete this exercise?');">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-outline-danger">Delete Exercise</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
