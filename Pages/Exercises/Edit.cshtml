@page "{id:int}"
@model WebApp.Pages.Exercises.EditModel
@using WebApp.Models
@{
    ViewData["Title"] = "Edit Exercise";
}

<h1>Edit Exercise</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label text-secondary small">Session type</label>
                <div class="btn-group segmented-control w-100" role="group">
                    <input type="radio" class="btn-check" name="Input.SessionType" id="ex-st-push" value="Push" autocomplete="off" checked="@(Model.Input.SessionType == TrainingSessionType.Push)">
                    <label class="btn" for="ex-st-push">Push</label>

                    <input type="radio" class="btn-check" name="Input.SessionType" id="ex-st-pull" value="Pull" autocomplete="off" checked="@(Model.Input.SessionType == TrainingSessionType.Pull)">
                    <label class="btn" for="ex-st-pull">Pull</label>

                    <input type="radio" class="btn-check" name="Input.SessionType" id="ex-st-legs" value="Legs" autocomplete="off" checked="@(Model.Input.SessionType == TrainingSessionType.Legs)">
                    <label class="btn" for="ex-st-legs">Legs</label>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.WeightType" class="form-label"></label>
                <select asp-for="Input.WeightType" class="form-select" data-fields-toggle="exercise-weight-fields">
                    @foreach (var weightType in Enum.GetValues<ExerciseWeightType>())
                    {
                        <option value="@weightType">@weightType.ToDisplayName()</option>
                    }
                </select>
                <div class="form-text">Bodyweight: added weight is optional. Free weight: type any weight each time. Machine: pick from the machine's own weight stack below.</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Machine settings <span class="text-secondary small">(optional)</span></label>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="input-group">
                            <span class="input-group-text" title="Seat/pad position (forward)">&#8596;</span>
                            <input asp-for="Input.SeatForwardPosition" type="number" step="0.5" class="form-control" placeholder="Forward" />
                        </div>
                        <span asp-validation-for="Input.SeatForwardPosition" class="text-danger"></span>
                    </div>
                    <div class="col-6">
                        <div class="input-group">
                            <span class="input-group-text" title="Seat/pad height">&#8597;</span>
                            <input asp-for="Input.SeatHeightPosition" type="number" step="0.5" class="form-control" placeholder="Height" />
                        </div>
                        <span asp-validation-for="Input.SeatHeightPosition" class="text-danger"></span>
                    </div>
                </div>
                <div class="form-text">If this exercise's machine/bench has an adjustable seat or pad, note the setting here so it's shown when you log it.</div>
            </div>

            <div class="mb-3 exercise-weight-fields" data-types="Machine">
                <label class="form-label">Weight stack (kg)</label>
                <div id="machine-weights-list">
                    @for (var i = 0; i < Model.Input.MachineWeights.Count; i++)
                    {
                        <div class="d-flex gap-2 mb-2 machine-weight-row">
                            <input type="number" step="0.5" name="Input.MachineWeights[@i]" class="form-control" value="@Model.Input.MachineWeights[i]" />
                            <button type="button" class="btn btn-outline-danger btn-sm remove-machine-weight">&times;</button>
                        </div>
                    }
                </div>
                <button type="button" id="add-machine-weight" class="btn btn-outline-secondary btn-sm">+ Add weight</button>
            </div>

            <div class="mb-3 exercise-weight-fields" data-types="Machine">
                <label class="form-label">Add-ons (kg)</label>
                <div id="machine-addons-list">
                    @for (var i = 0; i < Model.Input.MachineAddOns.Count; i++)
                    {
                        <div class="d-flex gap-2 mb-2 machine-addon-row">
                            <input type="number" step="0.5" name="Input.MachineAddOns[@i]" class="form-control" value="@Model.Input.MachineAddOns[i]" />
                            <button type="button" class="btn btn-outline-danger btn-sm remove-machine-addon">&times;</button>
                        </div>
                    }
                </div>
                <button type="button" id="add-machine-addon" class="btn btn-outline-secondary btn-sm">+ Add add-on</button>
            </div>

            <a asp-page="/Exercises/Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>

        <form method="post" asp-page-handler="Delete" class="mt-3" onsubmit="return confirm('Delete this exercise?');">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-outline-danger">Delete Exercise</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/list-repeater.js" asp-append-version="true"></script>
    <script src="~/js/exercise-lists.js" asp-append-version="true"></script>
    <script src="~/js/fields-toggle.js" asp-append-version="true"></script>
}
