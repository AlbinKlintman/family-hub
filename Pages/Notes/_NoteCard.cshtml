@model WebApp.Models.Note
@using WebApp.Helpers
@using WebApp.Models

<div id="note-@Model.Id" class="card mb-2 note-card @(Model.IsDone ? "note-card-done" : "")">
    <div class="card-body py-2 px-3">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                @if (Model is ToDoNote todo)
                {
                    <span class="badge note-badge note-badge-todo mb-1">To-Do</span>
                    @if (Model.Priority is not null)
                    {
                        <span class="badge @Model.Priority.Value.ToBadgeCssClass() mb-1">@Model.Priority.Value.ToDisplayName()</span>
                    }
                    <div class="fw-semibold note-card-title @(Model.IsDone ? "text-decoration-line-through" : "")">@todo.Title</div>
                    @if (todo.DueDate is not null)
                    {
                        <div class="small text-secondary">
                            Due @todo.DueDate.Value.ToString("ddd, MMM d")
                            @if (todo.DueTime is not null)
                            {
                                @(" at " + todo.DueTime.Value.ToString("HH:mm"))
                            }
                        </div>
                    }
                }
                else if (Model is LaundryNote laundry)
                {
                    <span class="badge note-badge note-badge-laundry mb-1">Laundry</span>
                    @if (Model.Priority is not null)
                    {
                        <span class="badge @Model.Priority.Value.ToBadgeCssClass() mb-1">@Model.Priority.Value.ToDisplayName()</span>
                    }
                    <div class="fw-semibold note-card-title @(Model.IsDone ? "text-decoration-line-through" : "")">@laundry.LaundryType.ToDisplayName()</div>
                    <div class="small text-secondary">
                        @laundry.Room.ToDisplayName()
                        @if (laundry.Day is not null)
                        {
                            @(" · " + laundry.Day.Value.ToString("ddd, MMM d"))
                        }
                        @(" · " + laundry.TimeWindow.ToDisplayName())
                    </div>
                }
                else if (Model is WorkShiftNote shift)
                {
                    <span class="badge note-badge note-badge-workshift mb-1">Work Shift</span>
                    @if (Model.Priority is not null)
                    {
                        <span class="badge @Model.Priority.Value.ToBadgeCssClass() mb-1">@Model.Priority.Value.ToDisplayName()</span>
                    }
                    <div class="fw-semibold note-card-title @(Model.IsDone ? "text-decoration-line-through" : "")">@shift.Location</div>
                    <div class="small text-secondary">
                        @if (shift.Day is not null)
                        {
                            @(shift.Day.Value.ToString("ddd, MMM d") + " · ")
                        }
                        @shift.StartTime.ToString("HH:mm")&ndash;@shift.EndTime.ToString("HH:mm")
                        @if (shift.Colleagues.Any())
                        {
                            @(" · " + string.Join(", ", shift.Colleagues.Select(c => c.Name)))
                        }
                    </div>
                }
                else if (Model is FastingNote fasting)
                {
                    <span class="badge note-badge note-badge-fasting mb-1">Fasting</span>
                    <div class="fw-semibold note-card-title @(Model.IsDone ? "text-decoration-line-through" : "")">@fasting.Day.ToString("ddd, MMM d")</div>
                    <div class="small text-secondary">@fasting.Level.ToShortLabel()</div>
                }
                <div class="small text-secondary">
                    Created @Model.CreatedAtUtc.ToRelativeString()
                    @if (Model.Folder is not null)
                    {
                        <span>
                            &middot;
                            <span class="folder-dot" style="background-color: @Model.Folder.Color.ToHex()"></span>
                            @Model.Folder.Name
                        </span>
                    }
                    @if (Model.Schedule is not null)
                    {
                        <span>
                            &middot;
                            <span class="folder-dot" style="background-color: @Model.Schedule.Color.ToHex()"></span>
                            @Model.Schedule.Name
                        </span>
                    }
                </div>
            </div>
            <div class="d-flex flex-column flex-sm-row gap-1">
                <form method="post" asp-page-handler="ToggleDone" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-sm btn-outline-success">
                        @(Model.IsDone ? "Reopen" : "Done")
                    </button>
                </form>
                <a asp-page="/Notes/Edit" asp-route-id="@Model.Id" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn btn-sm btn-outline-secondary">Edit</a>
            </div>
        </div>
    </div>
</div>
