@page
@model WebApp.Pages.Notes.FastingCalendarModel
@{
    ViewData["Title"] = "Fasting Calendar";
    var monthLabel = new DateOnly(Model.DisplayYear, Model.DisplayMonth, 1).ToString("MMMM yyyy");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Fasting Calendar</h1>
    <a asp-page="/Notes/Index" class="btn btn-outline-secondary btn-sm">Back to Notes</a>
</div>

<form method="get" class="mb-3">
    <label class="form-label small text-secondary">Painting level</label>
    <select name="Level" class="form-select" onchange="this.form.submit()">
        @foreach (var level in Enum.GetValues<WebApp.Models.FastingLevel>())
        {
            <option value="@level" selected="@(level == Model.Level)">@level.ToDisplayName()</option>
        }
    </select>
    <input type="hidden" name="Year" value="@Model.DisplayYear" />
    <input type="hidden" name="Month" value="@Model.DisplayMonth" />
</form>

<p class="small text-secondary">
    Check the days that should have this level, then Save. Unchecking a day that
    currently has this level clears it. Days with a <em>different</em> level already
    assigned are left alone unless you check them too.
</p>

<form method="post">
    <input type="hidden" asp-for="Year" value="@Model.DisplayYear" />
    <input type="hidden" asp-for="Month" value="@Model.DisplayMonth" />
    <input type="hidden" asp-for="Level" />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-page="/Notes/FastingCalendar" asp-route-year="@Model.PreviousMonth.Year" asp-route-month="@Model.PreviousMonth.Month" asp-route-level="@Model.Level" class="btn btn-outline-secondary btn-sm">&lsaquo; Prev</a>
        <span class="fw-semibold">@monthLabel</span>
        <a asp-page="/Notes/FastingCalendar" asp-route-year="@Model.NextMonth.Year" asp-route-month="@Model.NextMonth.Month" asp-route-level="@Model.Level" class="btn btn-outline-secondary btn-sm">Next &rsaquo;</a>
    </div>

    <div class="calendar-scroll">
        <table class="calendar-table">
            <thead>
                <tr>
                    <th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th><th>Sun</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var week in Model.Weeks)
                {
                    <tr>
                        @foreach (var day in week)
                        {
                            <td>
                                @if (day is not null)
                                {
                                    var hasExisting = Model.ExistingLevelsByDay.TryGetValue(day.Value.Day, out var existingLevel);
                                    var isCurrentLevel = hasExisting && existingLevel == Model.Level;
                                    <label class="fasting-day @(isCurrentLevel ? "fasting-day-checked" : "")">
                                        <input type="checkbox" name="CheckedDays" value="@day.Value.Day" checked="@isCurrentLevel" />
                                        <span class="fasting-day-number">@day.Value.Day</span>
                                        @if (hasExisting && !isCurrentLevel)
                                        {
                                            <span class="fasting-day-other" title="@existingLevel.ToDisplayName()">&#9679;</span>
                                        }
                                    </label>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button type="submit" class="btn btn-primary mt-3 w-100">Save</button>
</form>

<style>
    .fasting-day {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 3.5rem;
        border-radius: 8px;
        cursor: pointer;
        margin: 0;
    }

    .fasting-day input {
        margin-bottom: 0.2rem;
    }

    .fasting-day-checked {
        background-color: rgba(191, 90, 242, 0.2);
    }

    .fasting-day-other {
        font-size: 0.5rem;
        color: var(--ios-label-secondary);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
