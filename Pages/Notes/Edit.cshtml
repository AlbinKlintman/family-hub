@page "{id:int}"
@model WebApp.Pages.Notes.EditModel
@{
    ViewData["Title"] = "Edit Note";
}

<h1>Edit Note</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            @if (Model.CurrentType == WebApp.Models.NoteType.ToDo)
            {
                <div class="mb-3">
                    <label asp-for="Input.DueDate" class="form-label"></label>
                    <input asp-for="Input.DueDate" type="date" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.DueTime" class="form-label"></label>
                    <input asp-for="Input.DueTime" type="time" class="form-control" />
                </div>
            }
            else
            {
                <div class="mb-3">
                    <label asp-for="Input.Room" class="form-label"></label>
                    <input asp-for="Input.Room" class="form-control" />
                    <span asp-validation-for="Input.Room" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Day" class="form-label"></label>
                    <input asp-for="Input.Day" type="date" class="form-control" />
                </div>
                <div class="row">
                    <div class="col mb-3">
                        <label asp-for="Input.TimeWindowStart" class="form-label"></label>
                        <input asp-for="Input.TimeWindowStart" type="time" class="form-control" />
                    </div>
                    <div class="col mb-3">
                        <label asp-for="Input.TimeWindowEnd" class="form-label"></label>
                        <input asp-for="Input.TimeWindowEnd" type="time" class="form-control" />
                    </div>
                </div>
            }

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Notes/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>

        <form method="post" asp-page-handler="Delete" class="mt-3" onsubmit="return confirm('Delete this note?');">
            <button type="submit" class="btn btn-outline-danger btn-sm">Delete Note</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
