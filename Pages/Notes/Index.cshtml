@page
@model WebApp.Pages.Notes.IndexModel
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Notes</h1>
        <a asp-page="/Folders/Index" class="small">Folders</a>
    </div>
    <a asp-page="/Notes/Create" asp-route-folderId="@Model.FolderId" class="btn btn-primary">+ New Note</a>
</div>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="FolderId"></label>
        <select asp-for="FolderId" asp-items="Model.FolderOptions" class="form-select" onchange="this.form.submit()">
            <option value="">All folders</option>
            <option value="@WebApp.Pages.Notes.IndexModel.NoneSentinel">No folder</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="ScheduleId"></label>
        <select asp-for="ScheduleId" asp-items="Model.ScheduleOptions" class="form-select" onchange="this.form.submit()">
            <option value="">All schedules</option>
            <option value="@WebApp.Pages.Notes.IndexModel.NoneSentinel">No schedule</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="NoteType">Type</label>
        <select asp-for="NoteType" class="form-select" onchange="this.form.submit()">
            <option value="">All types</option>
            <option value="ToDo">To-Do</option>
            <option value="Laundry">Laundry</option>
            <option value="WorkShift">Work Shift</option>
            <option value="Fasting">Fasting</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="Sort">Sort</label>
        <select asp-for="Sort" class="form-select" onchange="this.form.submit()">
            <option value="DueDate">Due date</option>
            <option value="Newest">Newest added</option>
            <option value="Oldest">Oldest added</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small text-secondary" asp-for="DueFilter">Due</label>
        <select asp-for="DueFilter" class="form-select" onchange="this.form.submit()">
            <option value="">Any time</option>
            <option value="Today">Today</option>
            <option value="Tomorrow">Tomorrow</option>
            <option value="ThisWeek">This week</option>
            <option value="ThisMonth">This month</option>
        </select>
    </div>
    <div class="col-auto form-check">
        <input type="checkbox" class="form-check-input" asp-for="ShowCompleted" onchange="this.form.submit()" />
        <label class="form-check-label small text-secondary" asp-for="ShowCompleted">Show completed / past</label>
    </div>
</form>

<p class="small text-secondary mb-2">@Model.SummaryText</p>

@if (!Model.Notes.Any())
{
    <p class="text-muted">
        @(Model.ShowCompleted ? "No completed or past notes here." : "No notes here.")
    </p>
}

@{
    ViewData["ReturnUrl"] = Model.HttpContext.Request.Path + Model.HttpContext.Request.QueryString;
}
@foreach (var note in Model.Notes)
{
    <partial name="_NoteCard" model="note" />
}
