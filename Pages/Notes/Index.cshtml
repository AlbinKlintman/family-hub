@page
@model WebApp.Pages.Notes.IndexModel
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>@(Model.CurrentFolder?.Name ?? "Notes")</h1>
        @if (Model.CurrentFolder is not null)
        {
            <a asp-page="/Notes/Index" class="small">&larr; All notes</a>
        }
        else
        {
            <a asp-page="/Folders/Index" class="small">Folders</a>
        }
    </div>
    <a asp-page="/Notes/Create" asp-route-folderId="@Model.FolderId" class="btn btn-primary">+ New Note</a>
</div>

@if (!Model.OpenNotes.Any() && !Model.DoneNotes.Any())
{
    <p class="text-muted">No notes yet.</p>
}

@if (Model.OpenNotes.Any())
{
    @foreach (var note in Model.OpenNotes)
    {
        <partial name="_NoteCard" model="note" />
    }
}

@if (Model.DoneNotes.Any())
{
    <h2 class="h5 text-muted mt-4">Done</h2>
    @foreach (var note in Model.DoneNotes)
    {
        <partial name="_NoteCard" model="note" />
    }
}
