@page
@model WebApp.Pages.Notes.IndexModel
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Notes</h1>
    <a asp-page="/Notes/Create" class="btn btn-primary">+ New Note</a>
</div>

@if (!Model.OpenNotes.Any() && !Model.DoneNotes.Any())
{
    <p class="text-muted">No notes yet.</p>
}

@if (Model.OpenNotes.Any())
{
    @foreach (var note in Model.OpenNotes)
    {
        <partial name="_NoteCard" model="note" />
    }
}

@if (Model.DoneNotes.Any())
{
    <h2 class="h5 text-muted mt-4">Done</h2>
    @foreach (var note in Model.DoneNotes)
    {
        <partial name="_NoteCard" model="note" />
    }
}
