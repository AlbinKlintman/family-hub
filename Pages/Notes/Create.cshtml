@page
@model WebApp.Pages.Notes.CreateModel
@{
    ViewData["Title"] = "New Note";
}

<h1>New Note</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Input.NoteType" class="form-label"></label>
                <select asp-for="Input.NoteType" class="form-select" id="note-type-select">
                    <option value="ToDo">To-do</option>
                    <option value="Laundry">Laundry</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div id="section-ToDo">
                <div class="mb-3">
                    <label asp-for="Input.DueDate" class="form-label"></label>
                    <input asp-for="Input.DueDate" type="date" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Input.DueTime" class="form-label"></label>
                    <input asp-for="Input.DueTime" type="time" class="form-control" />
                </div>
            </div>

            <div id="section-Laundry">
                <div class="mb-3">
                    <label asp-for="Input.Room" class="form-label"></label>
                    <input asp-for="Input.Room" class="form-control" />
                    <span asp-validation-for="Input.Room" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.Day" class="form-label"></label>
                    <input asp-for="Input.Day" type="date" class="form-control" />
                </div>
                <div class="row">
                    <div class="col mb-3">
                        <label asp-for="Input.TimeWindowStart" class="form-label"></label>
                        <input asp-for="Input.TimeWindowStart" type="time" class="form-control" />
                    </div>
                    <div class="col mb-3">
                        <label asp-for="Input.TimeWindowEnd" class="form-label"></label>
                        <input asp-for="Input.TimeWindowEnd" type="time" class="form-control" />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save Note</button>
            <a asp-page="/Notes/Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var select = document.getElementById('note-type-select');
            var sections = {
                ToDo: document.getElementById('section-ToDo'),
                Laundry: document.getElementById('section-Laundry')
            };

            function updateVisibility() {
                Object.keys(sections).forEach(function (key) {
                    sections[key].classList.toggle('d-none', select.value !== key);
                });
            }

            select.addEventListener('change', updateVisibility);
            updateVisibility();
        })();
    </script>
}
