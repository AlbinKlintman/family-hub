@page
@model WebApp.Pages.Notes.CreateModel
@{
    ViewData["Title"] = "New Note";
}

<form method="post" class="note-form">
    <div asp-validation-summary="ModelOnly" class="text-danger px-3"></div>

    <div class="px-3 pt-1">
        <div class="segmented-control-grid">
            <input type="radio" class="btn-check" name="Input.NoteType" id="type-todo" value="ToDo" autocomplete="off" checked>
            <label class="btn" for="type-todo">To-Do</label>

            <input type="radio" class="btn-check" name="Input.NoteType" id="type-laundry" value="Laundry" autocomplete="off">
            <label class="btn" for="type-laundry">Laundry</label>

            <input type="radio" class="btn-check" name="Input.NoteType" id="type-workshift" value="WorkShift" autocomplete="off">
            <label class="btn" for="type-workshift">Work Shift</label>

            <input type="radio" class="btn-check" name="Input.NoteType" id="type-fasting" value="Fasting" autocomplete="off">
            <label class="btn" for="type-fasting">Fasting</label>
        </div>
    </div>

    <div id="section-ToDo">
        <textarea asp-for="Input.Title" class="note-title-input" placeholder="Note" rows="3" autofocus></textarea>
        <span asp-validation-for="Input.Title" class="text-danger px-3 d-block"></span>

        <div class="px-3 mt-2 d-flex gap-2">
            <div class="flex-fill">
                <label class="form-label text-secondary small" asp-for="Input.DueDate"></label>
                <input asp-for="Input.DueDate" type="date" class="form-control" />
            </div>
            <div class="flex-fill">
                <label class="form-label text-secondary small" asp-for="Input.DueTime"></label>
                <input asp-for="Input.DueTime" type="time" class="form-control" />
            </div>
        </div>
    </div>

    <div id="section-Laundry" class="px-3 pt-3 d-none">
        <div class="mb-3">
            <label class="form-label text-secondary small">Type</label>
            <div class="btn-group segmented-control w-100" role="group">
                <input type="radio" class="btn-check" name="Input.LaundryType" id="lt-normal" value="NormalClothes" autocomplete="off" checked>
                <label class="btn" for="lt-normal">Normal Clothes</label>

                <input type="radio" class="btn-check" name="Input.LaundryType" id="lt-bedlinen" value="BedLinenAndTowels" autocomplete="off">
                <label class="btn" for="lt-bedlinen">Bed Linen &amp; Towels</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-secondary small">Room</label>
            <div class="btn-group segmented-control w-100" role="group">
                <input type="radio" class="btn-check" name="Input.Room" id="room-1" value="Room1Left" autocomplete="off">
                <label class="btn" for="room-1">Room 1 (Left)</label>

                <input type="radio" class="btn-check" name="Input.Room" id="room-2" value="Room2Right" autocomplete="off" checked>
                <label class="btn" for="room-2">Room 2 (Right)</label>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-secondary small" asp-for="Input.Day"></label>
            <input asp-for="Input.Day" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label text-secondary small">Time window</label>
            <div class="segmented-control-grid">
                <input type="radio" class="btn-check" name="Input.TimeWindow" id="tw-morning" value="Morning" autocomplete="off">
                <label class="btn" for="tw-morning">7:00 – 10:00</label>

                <input type="radio" class="btn-check" name="Input.TimeWindow" id="tw-midday" value="Midday" autocomplete="off">
                <label class="btn" for="tw-midday">10:00 – 13:00</label>

                <input type="radio" class="btn-check" name="Input.TimeWindow" id="tw-afternoon" value="Afternoon" autocomplete="off" checked>
                <label class="btn" for="tw-afternoon">13:00 – 17:00</label>

                <input type="radio" class="btn-check" name="Input.TimeWindow" id="tw-evening" value="Evening" autocomplete="off">
                <label class="btn" for="tw-evening">17:00 – 21:00</label>
            </div>
        </div>
    </div>

    <div id="section-WorkShift" class="px-3 pt-3 d-none">
        <div class="mb-3">
            <label class="form-label text-secondary small" asp-for="Input.ShiftDay"></label>
            <input asp-for="Input.ShiftDay" type="date" class="form-control" />
        </div>

        <div class="mb-3 d-flex gap-2">
            <div class="flex-fill">
                <label class="form-label text-secondary small" asp-for="Input.StartTime"></label>
                <input asp-for="Input.StartTime" type="time" class="form-control" />
            </div>
            <div class="flex-fill">
                <label class="form-label text-secondary small" asp-for="Input.EndTime"></label>
                <input asp-for="Input.EndTime" type="time" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-secondary small" asp-for="Input.Location"></label>
            <input asp-for="Input.Location" class="form-control" placeholder="Falun" />
        </div>

        <div class="mb-3">
            <label class="form-label text-secondary small" asp-for="Input.ColleagueIds"></label>
            <select asp-for="Input.ColleagueIds" asp-items="Model.ColleagueOptions" class="form-select" multiple size="4"></select>
            <span asp-validation-for="Input.ColleagueIds" class="text-danger small"></span>
            <div class="small text-secondary mt-1">Ctrl/Cmd-click to pick up to 4. No colleagues yet? <a asp-page="/Colleagues/Index">Add some</a>.</div>
        </div>
    </div>

    <div id="section-Fasting" class="px-3 pt-3 d-none">
        <div class="mb-3">
            <label class="form-label text-secondary small" asp-for="Input.FastingDay"></label>
            <input asp-for="Input.FastingDay" type="date" class="form-control" />
            <span asp-validation-for="Input.FastingDay" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label text-secondary small" asp-for="Input.FastingLevel"></label>
            <select asp-for="Input.FastingLevel" class="form-select">
                @foreach (var level in Enum.GetValues<WebApp.Models.FastingLevel>())
                {
                    <option value="@level">@level.ToDisplayName()</option>
                }
            </select>
        </div>

        <div class="small text-secondary">
            Covering a lot of days at once? <a asp-page="/Notes/FastingCalendar">Use the bulk calendar view</a> instead.
        </div>
    </div>

    <div class="px-3 mt-3 d-flex gap-2">
        <div class="flex-fill">
            <label class="form-label text-secondary small" asp-for="Input.FolderId"></label>
            <select asp-for="Input.FolderId" asp-items="Model.FolderOptions" class="form-select">
                <option value="">&mdash; No folder &mdash;</option>
            </select>
        </div>
        <div class="flex-fill">
            <label class="form-label text-secondary small" asp-for="Input.ScheduleId"></label>
            <select asp-for="Input.ScheduleId" asp-items="Model.ScheduleOptions" class="form-select">
                <option value="">&mdash; No schedule &mdash;</option>
            </select>
        </div>
        <div class="flex-fill">
            <label class="form-label text-secondary small" asp-for="Input.Priority"></label>
            <select asp-for="Input.Priority" class="form-select">
                <option value="">&mdash; None &mdash;</option>
                <option value="High">High priority</option>
                <option value="Medium">Medium priority</option>
                <option value="Low">Low priority</option>
            </select>
        </div>
    </div>

    <div class="px-3 mt-4 d-flex gap-2">
        <a asp-page="/Notes/Index" class="btn btn-outline-secondary flex-fill">Cancel</a>
        <button type="submit" class="btn btn-primary flex-fill">Save</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var radios = {
                ToDo: document.getElementById('type-todo'),
                Laundry: document.getElementById('type-laundry'),
                WorkShift: document.getElementById('type-workshift'),
                Fasting: document.getElementById('type-fasting')
            };
            var sections = {
                ToDo: document.getElementById('section-ToDo'),
                Laundry: document.getElementById('section-Laundry'),
                WorkShift: document.getElementById('section-WorkShift'),
                Fasting: document.getElementById('section-Fasting')
            };

            function update() {
                var selected = 'ToDo';
                Object.keys(radios).forEach(function (key) {
                    if (radios[key].checked) selected = key;
                });
                Object.keys(sections).forEach(function (key) {
                    sections[key].classList.toggle('d-none', selected !== key);
                });
            }

            Object.keys(radios).forEach(function (key) {
                radios[key].addEventListener('change', update);
            });
            update();
        })();
    </script>
}
