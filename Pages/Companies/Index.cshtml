@page
@model WebApp.Pages.Companies.IndexModel
@{
    ViewData["Title"] = "Companies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Companies</h1>
    <a asp-page="/Board/Index" class="btn btn-outline-secondary">Back to Board</a>
</div>

<form method="post" asp-page-handler="Create" class="row g-2 mb-4">
    <div class="col-auto">
        <input asp-for="NewCompanyName" class="form-control" placeholder="Company name" />
        <span asp-validation-for="NewCompanyName" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Add Company</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Applications</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var company in Model.Companies)
        {
            <tr>
                <td>@company.Name</td>
                <td>@company.ApplicationCount</td>
                <td><a asp-page="/Companies/Edit" asp-route-id="@company.Id">Edit</a></td>
            </tr>
        }
        @if (!Model.Companies.Any())
        {
            <tr>
                <td colspan="3" class="text-muted">No companies yet.</td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
